# Database
DATABASE_URL="postgresql://user:password@localhost:5432/foodit?schema=public"

# NextAuth
# Production runs at https://kaushik-food-it.vercel.app — set NEXTAUTH_URL to that
# there, and keep http://localhost:3000 for local development.
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# and https://kaushik-food-it.vercel.app/api/auth/callback/google
GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_SECRET="your-google-client-secret"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"